{
  "name": "clube-florescer-expo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --lan",
    "start:clear": "expo start --lan -c",
    "dev": "node scripts/dev-expo.mjs",
    "dev:clear": "node scripts/dev-expo.mjs --clear",
    "dev:prod": "node scripts/dev-expo.mjs --prod",
    "simulator": "node scripts/open-simulator.mjs",
    "qr": "node scripts/open-dev-qr.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "routes:sync": "node scripts/generate-mirror-routes.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "build:ios": "eas build --platform ios --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:android": "EXPO_PUBLIC_API_BASE=https://apiclube.nutrisabellajardim.com.br/api eas build --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "update": "EXPO_PUBLIC_API_BASE=https://apiclube.nutrisabellajardim.com.br/api eas update --channel production --platform ios",
    "update:preview": "EXPO_PUBLIC_API_BASE=https://apiclube.nutrisabellajardim.com.br/api eas update --channel preview --platform ios",
    "metadata:push": "eas metadata:push",
    "metadata:pull": "eas metadata:pull"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "^0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "expo-video": "~3.0.16",
    "hls.js": "^1.5.7",
    "lucide-react-native": "^1.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
