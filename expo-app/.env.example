# ── Desenvolvimento (expo start / npm run dev:expo) ─────────────────────────
# auto = backend local :3001 (IP detectado automaticamente)
EXPO_PUBLIC_API_BASE=auto

# Porta do backend local (padrão 3001)
# EXPO_PUBLIC_API_PORT=3001

# Forçar API publicada durante o dev:
# EXPO_PUBLIC_API_BASE=https://apiclube.nutrisabellajardim.com.br/api

# URL fixa na LAN (sobrescreve auto):
# EXPO_PUBLIC_API_BASE=http://192.168.0.11:3001/api

# ── Produção (EAS build) ─────────────────────────────────────────────────────
# Definido em eas.json → EXPO_PUBLIC_API_BASE=https://apiclube.nutrisabellajardim.com.br/api

# ── App Store Connect API (submit + metadata) ─────────────────────────────────
# Gere em: App Store Connect → Users and Access → Integrations → API
# Guia: expo-app/docs/APPLE_API_KEY.md
# Salve o .p8 em expo-app/credentials/ (nunca commitar)
#
# EXPO_ASC_KEY_ID=
# EXPO_ASC_ISSUER_ID=
# EXPO_ASC_API_KEY_PATH=./credentials/AuthKey_XXXXXXXXXX.p8
#
# Depois de preencher eas.json submit.production.ios ou usar eas credentials.
