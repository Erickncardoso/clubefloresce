generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  NUTRICIONISTA
  PACIENTE
}

enum UserStatus {
  ATIVO
  INATIVO
  PENDENTE
}

enum UserPlan {
  FREE
  PREMIUM
  PLATINUM
}

enum RegistrationRequestStatus {
  PENDENTE
  APROVADO
  RECUSADO
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model PatientRegistrationRequest {
  id           String                    @id @default(uuid())
  name         String
  email        String
  phone        String?
  message      String?
  passwordHash String?
  status       RegistrationRequestStatus @default(PENDENTE)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([email])
  @@index([status, createdAt])
}

model User {
  id                      String     @id @default(uuid())
  email                   String     @unique
  password                String
  name                    String
  phone                   String?
  role                    Role       @default(PACIENTE)
  avatar                  String?
  status                  UserStatus @default(ATIVO)
  plan                    UserPlan   @default(FREE)
  accessExpiresAt         DateTime?
  billingPaymentMethod    String?
  approvalEmailSentAt     DateTime?
  approvalWhatsappSentAt  DateTime?
  approvalWhatsappMessage String?    @db.Text
  patientGoalsData        Json?
  patientProfileData      Json?
  onboardingCompletedAt   DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  transactions Transaction[]

  courses                      Course[]
  posts                        Post[]
  comments                     Comment[]
  notifications                Notification[]
  pushSubscriptions            PushSubscription[]
  lessonProgress               LessonProgress[]
  likedComments                Comment[]                      @relation("CommentLikes")
  likedPosts                   Post[]                         @relation("PostLikes")
  postReports                  PostReport[]
  communityBlocksMade          CommunityUserBlock[]           @relation("CommunityBlocksMade")
  communityBlocksReceived      CommunityUserBlock[]           @relation("CommunityBlocksReceived")
  whatsappChats                WhatsappChat[]
  whatsappContactStates        WhatsappContactState[]
  whatsappContactDirectory     WhatsappContactDirectory?
  whatsappGroupObservedSenders WhatsappGroupObservedSenders[]
  whatsappMediaArchives        WhatsappMediaArchive[]
  whatsappMessages             WhatsappMessage[]
  whatsappSessionBinding       WhatsappSessionBinding?
  weeklyCheckIns               WeeklyCheckIn[]
  checkInTemplates             CheckInTemplate[]              @relation("CheckInTemplateAuthor")
  checkInDispatchSchedules     CheckInDispatchSchedule[]      @relation("CheckInDispatchAuthor")
  checkInResponses             CheckInResponse[]
  bellaMessages                BellaMessage[]
  nutritionTarget              NutritionTarget?
  foodDiaryEntries             FoodDiaryEntry[]
  patientMealPlan              PatientMealPlan?
  passwordResetTokens          PasswordResetToken[]
  billingSubscriptions         BillingSubscription[]
  billingCheckoutSessions      BillingCheckoutSession[]
  billingNotificationLogs      BillingNotificationLog[]
  instagramConfig              InstagramConfig?
  instagramAutomations         InstagramAutomation[]
  instagramContacts            InstagramContact[]
  instagramQueueItems          InstagramQueueItem[]
  instagramEvents              InstagramEvent[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PatientMealPlan {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String
  pdfUrl       String?
  title        String?
  patientName  String?
  prescribedAt String?
  plan         Json
  parserSource String   @default("dietbox")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WeeklyCheckIn {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime
  mood      Int
  energy    Int
  adherence Int?
  weightKg  Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([weekStart])
}

model CheckInTemplate {
  id                String                    @id @default(uuid())
  title             String
  description       String?
  frequency         String                    @default("weekly")
  active            Boolean                   @default(true)
  steps             Json
  sortOrder         Int                       @default(0)
  isDefault         Boolean                   @default(false)
  authorId          String
  author            User                      @relation("CheckInTemplateAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  responses         CheckInResponse[]
  dispatchSchedules CheckInDispatchSchedule[]

  @@index([active, sortOrder])
  @@index([authorId])
}

model CheckInDispatchSchedule {
  id          String           @id @default(uuid())
  templateId  String?
  template    CheckInTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  userIds     Json             @default("[]")
  periodDate  String?
  scheduledAt DateTime
  sentAt      DateTime?
  status      String           @default("pending")
  title       String?
  body        String?
  authorId    String
  author      User             @relation("CheckInDispatchAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@index([status, scheduledAt])
  @@index([authorId])
}

model CheckInResponse {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String
  template   CheckInTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  periodKey  String
  answers    Json
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([userId, templateId, periodKey])
  @@index([templateId, periodKey])
  @@index([userId])
}

model BellaMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  topic     String   @default("general")
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, topic, createdAt])
}

model NutritionTarget {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caloriesKcal Int      @default(2000)
  proteinG     Float    @default(120)
  carbsG       Float    @default(220)
  fatG         Float    @default(65)
  updatedAt    DateTime @updatedAt
}

enum FoodSource {
  TACO
  TBCA
}

model FoodItem {
  id           String     @id @default(uuid())
  source       FoodSource
  sourceCode   String
  name         String
  category     String?
  nutrients    Json
  caloriesKcal Float?
  proteinG     Float?
  carbsG       Float?
  fatG         Float?
  fiberG       Float?
  sodiumMg     Float?
  searchText   String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([source, sourceCode])
  @@index([name])
  @@index([searchText])
  @@index([source])
}

/// Base curada (pequena) para itens tradicionais do app (ex.: Whey).
/// Mantém macros consistentes e garante que a busca encontre esses itens.
model FoodOverride {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  category     String?
  caloriesKcal Float
  proteinG     Float
  carbsG       Float
  fatG         Float
  fiberG       Float?
  sodiumMg     Float?
  searchText   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@index([searchText])
}

model FoodDiaryEntry {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryDate    DateTime @db.Date
  mealType     String
  mealLabel    String?
  imageUrl     String?
  items        Json
  caloriesKcal Float
  carbsG       Float
  proteinG     Float
  fatG         Float
  createdAt    DateTime @default(now())

  @@index([userId, entryDate])
}

model Course {
  id                        String   @id @default(uuid())
  title                     String
  description               String?
  thumbnail                 String?
  thumbnailMobile           String?
  bannerImage               String?
  bannerImageMobile         String?
  bannerImagePosition       String?
  bannerImageMobilePosition String?
  bannerKicker              String?
  bannerTitle               String?
  bannerSubtitle            String?
  bannerCtaText             String?
  bannerKickerColor         String?
  bannerKickerBg            String?
  bannerTitleColor          String?
  bannerSubtitleColor       String?
  bannerCtaBg               String?
  bannerCtaColor            String?
  bannerSecondaryBtnBg      String?
  bannerSecondaryBtnColor   String?
  authorId                  String
  author                    User     @relation(fields: [authorId], references: [id])
  modules                   Module[]
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model Module {
  id          String   @id @default(uuid())
  title       String
  description String?
  thumbnail   String?
  order       Int      @default(0)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
}

model Lesson {
  id        String  @id @default(uuid())
  title     String
  videoUrl  String
  content   String?
  thumbnail String?
  duration  String?
  order     Int     @default(0)
  moduleId  String
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  materials     Json?            @default("[]")
  transcription Json?            @default("[]")
  progress      LessonProgress[]
  comments      Comment[]
}

model LessonProgress {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  watched   Boolean  @default(false)
  liked     Boolean  @default(false)
  disliked  Boolean  @default(false)
  favorited Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

model Ebook {
  id          String   @id @default(uuid())
  title       String
  description String
  fileUrl     String
  thumbnail   String?
  createdAt   DateTime @default(now())
}

model Post {
  id         String    @id @default(uuid())
  content    String
  imageUrl   String?
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  createdAt  DateTime  @default(now())
  likesCount Int       @default(0)
  likedBy    User[]    @relation("PostLikes")
  comments   Comment[]
  reports    PostReport[]
}

model PostReport {
  id         String   @id @default(uuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  createdAt  DateTime @default(now())

  @@unique([postId, reporterId])
  @@index([postId, createdAt])
}

model CommunityUserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("CommunityBlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("CommunityBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId, createdAt])
}

model Comment {
  id         String   @id @default(uuid())
  content    String
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  lessonId   String?
  lesson     Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  likesCount Int      @default(0)
  likedBy    User[]   @relation("CommentLikes")
  createdAt  DateTime @default(now())
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   @default("general")
  title      String
  body       String
  actionPath String?
  sourceKey  String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([userId, sourceKey])
  @@index([userId, read, createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, endpoint])
  @@index([userId])
}

model Transaction {
  id                       String    @id @default(uuid())
  amount                   Float
  status                   String    @default("PAID") // PAID, PENDING, CANCELLED, REFUNDED
  userId                   String
  user                     User      @relation(fields: [userId], references: [id])
  plan                     UserPlan?
  paymentMethod            String?
  mercadoPagoPaymentId     String?   @unique
  mercadoPagoPreapprovalId String?
  externalReference        String?   @unique
  metadata                 Json?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model BillingSubscription {
  id                       String    @id @default(uuid())
  userId                   String
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                     UserPlan
  status                   String    @default("pending") // pending, authorized, paused, cancelled
  paymentMethod            String?
  amount                   Float
  currency                 String    @default("BRL")
  mercadoPagoPreapprovalId String?   @unique
  nextBillingAt            DateTime?
  rawPayload               Json?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([userId, status])
}

model BillingWebhookEvent {
  id          String   @id @default(uuid())
  eventKey    String   @unique
  topic       String?
  payload     Json?
  processedAt DateTime @default(now())
}

model BillingCheckoutSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  completedAt      DateTime?
  reminder5SentAt  DateTime?
  reminder15SentAt DateTime?

  @@index([userId, completedAt])
  @@index([startedAt])
}

model BillingNotificationLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String
  type      String
  status    String
  detail    String?  @db.Text
  error     String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model WhatsappChat {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatJid         String
  sessionJid      String?
  name            String?
  pushName        String?
  avatarUrl       String?
  isGroup         Boolean  @default(false)
  lastMessage     String?
  lastMessageTime BigInt?
  unreadCount     Int      @default(0)
  raw             Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, chatJid])
  @@index([userId, lastMessageTime])
  @@index([userId, sessionJid, lastMessageTime])
}

// Diretório de contatos salvos: { jid/phone: nome } — fonte de nomes no chat.
// Um registro por usuário, atualizado a cada sync com UAZAPI /contacts/list.
model WhatsappContactDirectory {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json // { "55119...@s.whatsapp.net": "Nome Salvo", ... }
  updatedAt DateTime @updatedAt
}

// Nomes aprendidos no chat de grupo (LID/JID → display), persistidos para histórico reabrir com rótulos.
model WhatsappGroupObservedSenders {
  id        String   @id @default(uuid())
  userId    String
  groupJid  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json // { "....@lid": "Maria", "5511...@s.whatsapp.net": "João", ... }
  updatedAt DateTime @updatedAt

  @@unique([userId, groupJid])
  @@index([userId])
}

model WhatsappContactState {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactJid      String
  isSaved         Boolean   @default(false)
  isBusiness      Boolean   @default(false)
  phone           String?
  displayName     String?
  avatarUrl       String?
  details         Json?
  detailsSyncedAt DateTime?
  lastCheckedAt   DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, contactJid])
  @@index([userId, updatedAt])
}

// Mensagens persistidas (webhook history/messages + sync message/find).
// JID da conta WhatsApp vinculada ao nutri — detecta troca de aparelho/conta e purga cache local.
model WhatsappSessionBinding {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionJid String
  updatedAt  DateTime @updatedAt
}

model WhatsappMessage {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatJid          String
  sessionJid       String?
  messageId        String
  messageTimestamp BigInt
  fromMe           Boolean  @default(false)
  raw              Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, messageId])
  @@index([userId, chatJid, messageTimestamp])
  @@index([userId, sessionJid, chatJid, messageTimestamp])
}

// ============================================================
// Instagram — automação comentário/story/DM → DM com link
// ============================================================

enum InstagramMatchType {
  EXACT
  CONTAINS
}

enum InstagramQueueStatus {
  pending
  sending
  sent
  failed
  skipped
}

enum InstagramQueueKind {
  PRIVATE_REPLY // resposta privada a comentário (recipient.comment_id)
  PUBLIC_REPLY // reply público no comentário
  WELCOME_DM // DM de boas-vindas (story/DM com palavra-chave)
  FOLLOWUP // link/lembrete após quick reply
}

// Conexão da conta Instagram do nutri (token de longa duração, 60d).
model InstagramConfig {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken       String   @db.Text
  tokenExpiresAt    DateTime
  instagramUserId   String
  instagramUsername String
  profilePictureUrl String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tokenExpiresAt])
}

model InstagramAutomation {
  id                    String             @id @default(uuid())
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  active                Boolean            @default(true)
  // gatilhos
  triggerComment        Boolean            @default(true)
  triggerStory          Boolean            @default(false)
  triggerDm             Boolean            @default(false)
  keywords              Json               @default("[]") // ["EBOOK", "QUERO"]
  matchType             InstagramMatchType @default(CONTAINS)
  targetMediaId         String? // null = qualquer post/reels
  // respostas
  publicReplyVariations Json               @default("[]") // sorteia uma
  welcomeMessage        String             @db.Text
  quickReplyLabel       String             @default("Quero o link!")
  // link enviado após o quick reply
  linkText              String?            @db.Text
  linkButtonLabel       String?
  linkUrl               String?
  // lembrete se não houver clique/resposta
  reminderText          String?            @db.Text
  reminderDelayMinutes  Int                @default(60)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  followups  InstagramFollowup[]
  queueItems InstagramQueueItem[]

  @@index([userId, active])
}

// Sequência extra de follow-ups por automação (além de link + lembrete).
model InstagramFollowup {
  id           String              @id @default(uuid())
  automationId String
  automation   InstagramAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  type         String              @default("message") // message | link
  delayMinutes Int                 @default(0)
  body         String              @db.Text
  buttonLabel  String?
  url          String?
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([automationId, sortOrder])
}

// Pessoa que interagiu (IGSID — id com escopo do app, único por pessoa).
model InstagramContact {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramScopedId String    @unique
  username          String?
  firstContactAt    DateTime  @default(now())
  lastReplyAt       DateTime?
  lastAutomationId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, lastReplyAt])
}

// Fila de envio — worker drena com FOR UPDATE SKIP LOCKED (~2/s).
model InstagramQueueItem {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  automationId String?
  automation   InstagramAutomation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  kind         InstagramQueueKind
  status       InstagramQueueStatus @default(pending)
  recipientId  String? // IGSID para DM
  commentId    String? // para private/public reply
  payload      Json // corpo da mensagem a enviar
  scheduledFor DateTime             @default(now())
  claimedAt    DateTime?
  claimedBy    String?
  attempts     Int                  @default(0)
  lastError    String?              @db.Text
  sentAt       DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, scheduledFor])
  @@index([userId, createdAt])
}

// Log bruto de tudo que chega no webhook.
model InstagramEvent {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  field     String? // comments | messages | ...
  payload   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([field, createdAt])
}

// Mídia do WhatsApp arquivada no Backblaze B2 (links da UAZAPI expiram).
model WhatsappMediaArchive {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId  String
  chatJid    String?
  mimeType   String?
  storageKey String
  publicUrl  String
  sourceUrl  String?
  sizeBytes  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, messageId])
  @@index([userId, chatJid])
}

enum KnowledgeSourceType {
  lesson
  ebook
  course
  post
  meal_plan
  checkin
  profile
  food
  nutri_note
}

model KnowledgeChunk {
  id          String              @id @default(uuid())
  content     String              @db.Text
  contentHash String
  sourceType  KnowledgeSourceType
  sourceId    String
  userId      String?
  title       String
  url         String?
  metadata    Json?
  searchText  String              @db.Text
  chunkIndex  Int                 @default(0)
  indexedAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([sourceType, sourceId, userId, chunkIndex])
  @@index([sourceType, sourceId])
  @@index([userId, sourceType])
}

model RagQueryLog {
  id              String   @id @default(uuid())
  userId          String?
  query           String   @db.Text
  expandedQueries Json?
  chunkIds        Json?
  topScore        Float?
  matched         Boolean  @default(false)
  topic           String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([matched, createdAt])
}
